# USB-serial adapters of this setup (see docs/teleop_guide.md). Both are FTDI FT232H (0403:6014), so
# they are told apart only by their serial number; /dev/ttyUSB0 / 1 depend on the plug order.
# Each adapter: 1) a stable device name, 2) FTDI latency_timer 1 ms (default 16 ms). The latency_timer
# attribute is on the usb-serial device (ttyUSB*); vendor, product and serial are matched on its parent
# USB device (ATTRS).

# RB-Y1 leader arm: U2D2 (serial FT62AJAX) since 2026-10-30 -> /dev/rby1_leader_arm
# (the leader's own FTDI adapter FT62AJW7 corrupted 3-5 % of the replies at 2 Mbps and is no longer used)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", ATTRS{serial}=="FT62AJAX", SYMLINK+="rby1_leader_arm"
ACTION=="add", SUBSYSTEM=="usb-serial", DRIVER=="ftdi_sio", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", ATTRS{serial}=="FT62AJAX", ATTR{latency_timer}="1"

# Gripper: U2D2 (serial FT3WHQ1M, MX-106T) since 2026-10-30 -> /dev/gripper_u2d2
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", ATTRS{serial}=="FT3WHQ1M", SYMLINK+="gripper_u2d2"
ACTION=="add", SUBSYSTEM=="usb-serial", DRIVER=="ftdi_sio", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", ATTRS{serial}=="FT3WHQ1M", ATTR{latency_timer}="1"
